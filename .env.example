# 复制为 .env.local 后按需修改：cp .env.example .env.local
# .env.local 不入库；真实密钥只放在本地或部署环境里。

# 本地 SQLite 数据库文件（.data/ 已 gitignore）
DATABASE_URL="file:./.data/autotest.db"

# OpenAI 兼容的模型网关
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# 产物落盘根目录（截图、日志、报告）
ARTIFACT_DIR="./artifacts"

# 单次 run 的总超时（毫秒），默认 10 分钟
RUN_TIMEOUT_MS="600000"

# 单个项目允许的并发 run 数
MAX_RUNS_PER_PROJECT="1"
